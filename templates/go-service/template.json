{
  "specVersion": "1",
  "name": "go-service",
  "description": "Minimal Go HTTP service scaffold",
  "variables": [
    {
      "name": "projectName",
      "type": "string",
      "required": true,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Go module / binary name (kebab-case)"
    },
    {
      "name": "goVersion",
      "type": "enum",
      "default": "1.22",
      "values": ["1.21", "1.22", "1.23"],
      "description": "Go toolchain version"
    },
    {
      "name": "port",
      "type": "int",
      "default": 8080,
      "min": 1024,
      "max": 65535,
      "description": "HTTP listen port"
    },
    {
      "name": "features",
      "type": "list",
      "itemType": "string",
      "default": ["health"],
      "description": "Feature flags to include"
    },
    {
      "name": "includeLicense",
      "type": "bool",
      "default": true,
      "description": "Generate an MIT license file"
    }
  ],
  "files": [
    {
      "id": "go.mod",
      "source": "files/go.mod.tmpl",
      "target": "go.mod"
    },
    {
      "id": "main",
      "source": "files/main.go.tmpl",
      "target": "cmd/{{.projectName}}/main.go",
      "dependsOn": ["go.mod"]
    },
    {
      "source": "files/gitignore.tmpl",
      "target": ".gitignore",
      "conflict": "merge"
    },
    {
      "source": "files/readme.tmpl",
      "target": "README.md"
    },
    {
      "source": "files/license.tmpl",
      "target": "LICENSE",
      "condition": "{{.includeLicense}}"
    },
    {
      "source": "files/feature.tmpl",
      "target": "docs/{{.item}}.md",
      "each": "features"
    }
  ]
}
